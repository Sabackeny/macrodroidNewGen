<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginStart="@dimen/margin_medium" android:layout_marginEnd="@dimen/margin_medium"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_medium">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="1.0">
            <androidx.appcompat.widget.AppCompatEditText android:id="@id/titleText" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="@string/title" android:maxLines="1" android:singleLine="true">
                <requestFocus />
            </androidx.appcompat.widget.AppCompatEditText>
        </com.google.android.material.textfield.TextInputLayout>
        <Button android:id="@id/titleMagicTextButton" android:layout_marginTop="@dimen/margin_tiny" style="@style/MagicTextButton" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:layout_weight="1.0">
            <androidx.appcompat.widget.AppCompatEditText android:id="@id/subtitleText" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="@string/subtitle" android:maxLines="1" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <Button android:id="@id/subtitleMagicTextButton" android:layout_marginTop="@dimen/margin_tiny" style="@style/MagicTextButton" />
    </LinearLayout>
    <TextView android:textSize="14.0sp" android:textColor="@color/actions_accent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:text="@string/save_to_variable" />
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <com.arlosoft.macrodroid.widget.NDSpinner android:id="@id/booleanVariableSpinner" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="1.0" />
        <Button android:textColor="@color/default_text_color_inverse" android:id="@id/addVariableButton" android:layout_width="@dimen/special_text_button_width" android:layout_height="wrap_content" android:text="+" app:backgroundTint="@color/actions_accent" />
    </LinearLayout>
    <CheckBox android:id="@id/allowPinOrSwipePatternCheckBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/margin_small" android:text="@string/action_user_authenticaion_allow_pin_or_swipe_pattern" android:layout_marginVertical="@dimen/margin_small" />
    <include layout="@layout/include_ok_cancel_buttons" />
</LinearLayout>