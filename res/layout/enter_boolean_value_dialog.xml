<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RadioGroup android:orientation="horizontal" android:padding="@dimen/margin_medium" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <RadioButton android:id="@id/trueRadio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/true_label" />
        <RadioButton android:id="@id/falseRadio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/false_label" android:layout_marginStart="@dimen/margin_medium" />
    </RadioGroup>
    <View android:background="@color/ok_cancel_button_border" android:layout_width="fill_parent" android:layout_height="1.0dip" />
    <LinearLayout android:gravity="end" android:id="@id/button_bar" android:paddingTop="0.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <Button android:id="@id/cancelButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/button_bar_button_min_width" android:text="@android:string/cancel" style="?android:buttonBarButtonStyle" />
        <View android:background="@color/ok_cancel_button_border" android:layout_width="1.0dip" android:layout_height="fill_parent" />
        <Button android:id="@id/okButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="@dimen/button_bar_button_min_width" android:text="@android:string/ok" style="?android:buttonBarButtonStyle" />
    </LinearLayout>
</LinearLayout>