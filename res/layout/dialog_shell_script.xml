            <RadioButton android:id="@id/shizuku" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shizuku" android:layout_marginStart="@dimen/margin_small" />
        </RadioGroup>
        <TextView android:textSize="12.0sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12.0dip" android:layout_marginRight="12.0dip" android:text="@string/shell_root_info" android:layout_marginHorizontal="12.0dip" />
        <CheckBox android:id="@id/helperFileCheckBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:text="@string/use_helper_file" android:layout_marginStart="@dimen/margin_small" />
        <TextView android:textSize="12.0sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12.0dip" android:layout_marginRight="12.0dip" android:text="@string/use_helper_file_shell_script_info" android:layout_marginHorizontal="12.0dip" />
